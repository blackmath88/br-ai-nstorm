{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "br-ai-nstorm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_LOG",
        "class_name": "EventLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventLog"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health", "/mcp*"]
  },
  "observability": {
    "enabled": true
  }
}
