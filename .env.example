# Identity for the stdio MCP prototype. Real OAuth/OIDC comes later.
BRAINSTORM_ACTOR_ID=person:achim

# Optional local JSON event-store path.
BRAINSTORM_DATA_FILE=server/data/memory.json

# Minimal AI curator. Leave both unset for deterministic-only curation.
OPENAI_API_KEY=
OPENAI_MODEL=

# Minimal HTTP API port.
PORT=8787
