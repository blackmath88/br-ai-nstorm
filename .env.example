# --- HTTP -------------------------------------------------------------------
# Serves the REST API on /api and stateless MCP on /mcp.
PORT=8787

# --- persistence ------------------------------------------------------------
# Local append-only JSON event log. Disposable by design; see
# docs/architecture/ADR-003-v0.3-shared-room.md §4 for the Postgres trigger.
BRAINSTORM_DATA_FILE=server/data/memory.json

# --- identity ---------------------------------------------------------------
# The prototype login stub (POST /api/auth/session, GET /api/participants).
# Set to "off" anywhere that is not a developer machine.
BRAINSTORM_PROTOTYPE_AUTH=on

# For the stdio MCP server, pick ONE:
#   BRAINSTORM_TOKEN       an opaque session token the server issued (the real path)
#   BRAINSTORM_PARTICIPANT Achim | Kai | Lea | Mara — mints a stable dev token
# The client never asserts an identity; the server resolves the token.
BRAINSTORM_PARTICIPANT=Achim
# BRAINSTORM_TOKEN=

# --- optional AI curator ----------------------------------------------------
# Leave both unset for deterministic-only curation. The AI may only propose.
OPENAI_API_KEY=
OPENAI_MODEL=
